@model Proyector;   
@{
    ViewData["Title"] = "Detalles del proyector";
}

<div class="container">
    <h2 class="display-5">Información del proyector # @Model.Id</h2>


    <div>
        <div class ="form-group mb-3">
            <label class="form-label">Marca:</label>
            <label class="form-label">@Model.Marca</label>
        </div>

        <div class ="form-group mb-3">
            <label class="form-label">Modelo:</label>
            <label class="form-label ">@Model.Modelo</label>
        </div>

        <div class="form-group mb-3">
            <label class="form-label"># de serie:</label>
            <label class="form-label">@Model.NumeroDeSerie</label>
        </div>

        <div class="form-group mb-3">
            <label>Fecha de alta:</label>
            <label>@Model.FechaDeAlta.ToShortDateString()</label>
        </div>

        <div class="form-group mb-3">
            <label>Fecha de baja:</label>
            <label class="form-page">@Model.FechaDeBaja?.ToShortDateString()</label>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Situación:</label>
            <label class="form-label">@Model.Situacion</label>
        </div>

        
    </div>

    <div class="aling-content-end">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"> Cerrar </a>

    </div>
   
   
</div>